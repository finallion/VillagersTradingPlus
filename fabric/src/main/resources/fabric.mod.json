{
  "schemaVersion": 1,
  "id": "villagertradingplus",
  "version": "${version}",
  "name": "VillagersTradingPlus",
  "description": "A library that replaces Minecraft's villager trading with a datapack-driven system.",
  "authors": [
    "LithiumPlus"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/villagerstradingplus",
    "sources": "https://github.com/finallion/VillagersTradingPlus",
    "issues": "https://github.com/finallion/VillagersTradingPlus/issues"
  },

  "license": "GPL-3.0-only",
  "icon": "villagertradingplus_logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lion.villagertradingplus.fabric.VillagerTradingPlusFabric"
    ],
    "client": [
      "com.lion.villagertradingplus.fabric.VillagerTradingPlusClientFabric"
    ]
  },
  "mixins": [
    "villagertradingplus-common.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-api": ">=0.83.0",
    "minecraft": ">=1.20 <1.20.2-",
    "java": ">=17"
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://www.patreon.com/cw/LithiumPlus"
      }
    }
  }
}
